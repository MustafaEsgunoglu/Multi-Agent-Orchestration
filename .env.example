# Application
APP_ENV=development
APP_NAME=Multi-Agent Orchestration Platform
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000"]

# PostgreSQL 16 + pgvector
# Use a non-superuser app role in production so PostgreSQL RLS is enforced cleanly.
DATABASE_URL=postgresql+asyncpg://app_user:app_password@localhost:5432/orchestrator
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=orchestrator

# Redis (Celery broker & result backend)
REDIS_URL=redis://localhost:6379/0

# JWT Authentication (replace with strong 32+ byte random string in production)
JWT_SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# AES-256-GCM Master Key (32-byte key encoded as URL-safe base64 or 64-char hex)
# Generate with: python -c "import secrets, base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
MASTER_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# Observability (Optional: Langfuse Cloud)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
